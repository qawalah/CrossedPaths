# Copy to .env next to docker-compose.yml and change what you need. Every value has a default.
# SECRET_KEY / DATA_KEY: leave unset to have them generated once into data/keys.json (keep that file!).
# SECRET_KEY=
# DATA_KEY=
INVITE_CODE=
ALLOW_REGISTRATION=true
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAX_UPLOAD_MB=80
UPLOAD_TTL_HOURS=24
UPLOAD_KEEP_MAX_DAYS=0
RESULTS_TTL_DAYS=14
BLUR_M=100
PLACE_NAMES=true
# CHECK_INVITE_DAYS=7
# Sign-in by phone (code sent on WhatsApp) and Google. See HANDOVER.md "Sign-in methods".
AUTH_PHONE=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGS=en,ar
# PHONE_COUNTRIES=            # empty = every country
# LIMIT_OTP_PER_PHONE_PER_HOUR=3
# LIMIT_OTP_PER_IP_PER_HOUR=20
# LIMIT_OTP_PER_DAY=500
AUTH_GOOGLE=false
# GOOGLE_CLIENT_IDS=          # web client id first
# LIMIT_UPLOADS_PER_DAY=10
# LIMIT_REQUESTS_PER_DAY=20
# LIMIT_CHECKS_PER_DAY=10
# LIMIT_CHECKS_PER_PAIR_PER_DAY=3
